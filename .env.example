# Public site URL. Used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://smallbatchbourbon.com

# Supabase. The publishable key is safe in the browser and is always subject to
# Row Level Security. The service-role key bypasses RLS — it must never appear
# in NEXT_PUBLIC_* and never be sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Newsletter provider (Beehiiv). Without these the signup endpoint returns a
# provider error instead of silently discarding subscribers.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Search engine indexing. Unset means NOT indexed — the safe default while the
# database still holds fictional demo bottles. Set to exactly `true` once the
# demo rows are cleared and real content is in.
NEXT_PUBLIC_ALLOW_INDEXING=

# Analytics.
#
# Vercel Web Analytics needs no key — it is enabled per-project in the Vercel
# dashboard and served same-origin. Both providers below are cookieless and
# store no personal data, which is why the site needs no consent banner. Do not
# add a provider that sets cookies without also adding consent.
#
# Cloudflare Web Analytics: optional second opinion on raw traffic. Without a
# token, no beacon is injected.
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# Google Search Console verification. Prefer a DNS TXT record if you manage DNS
# at Cloudflare; this meta-tag value is the fallback when you do not.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Cloudflare Turnstile. Protects /api/newsletter — the only public write
# endpoint on the site. The site key is public by design and belongs in
# NEXT_PUBLIC_*; the secret key is server-only and must never carry that prefix.
#
# Leave both unset and verification is skipped entirely, which is what keeps
# local development and tests frictionless. Setting only the secret would reject
# every real signup, since no widget would exist to mint a token — set both or
# neither.
#
# Keep pre-clearance OFF on the widget (Cloudflare's default). With it on,
# Turnstile issues a cf_clearance cookie, which breaks the site's
# "exactly one cookie" privacy position and would require a consent banner.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
